# ---- Claude (agent reasoning). Without a key the agent uses the offline rule-based planner. ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- ArcGIS Online (optional). Without these the app runs in local synthetic-data demo mode. ----
ARCGIS_URL=https://www.arcgis.com
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
# Optional publishable, scoped API key for Esri basemaps in the browser map
ARCGIS_JS_API_KEY=
ARCGIS_LAYER_PREFIX=GeoAIOps

# ---- App ----
GEOAI_DB_PATH=data/geoai.sqlite
GEOAI_SEED=20260101

# Citizen-report feed (Balady/940 simulation). Disabled by default; set to 1 to enable.
GEOAI_CITIZEN_REPORTS=0

# In-app investigator form (field.html). Disabled by default; set to 1 to enable it alongside ArcGIS Field Maps.
GEOAI_FIELD_FORM=0

# Planner at start-up: rules | claude | openai | google | lmstudio | ollama | hermes | custom. Empty = Claude when ANTHROPIC_API_KEY is set, else rules.
# The Operation page can switch it at any time (keys typed there stay in memory only).
# GEOAI_PLANNER=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Language of the task text on investigators' phones in ArcGIS Field Maps: en (default), ar, or both (Arabic first, then English).
# The web pages have their own EN / العربية switch.
GEOAI_FIELD_LANG=en

# Each investigator's ArcGIS Online (Field Maps) username, so their assignments carry it: worker id = username, comma separated.
# GEOAI_FIELD_USERS=WRK-001=nawaf.harbi,WRK-002=khalid.otaibi
