# Riyadh City View. Copy to .env (or run: python scripts/make_env.py <another .env>). Never commit .env.

# ---- ArcGIS Online: the system of record. The app cannot start without these. ----
ARCGIS_URL=https://www.arcgis.com
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
# Hosted layers are titled <prefix>_<layer>. "GeoAIOps" (the Agentic_AI_City project's layers) is refused by the app.
ARCGIS_LAYER_PREFIX=CityView
# Optional publishable, scoped API key for Esri basemaps in the browser map
ARCGIS_JS_API_KEY=

# ---- Where the records live: arcgis (default) or memory (development only; nothing is kept) ----
GEOAI_STORE=arcgis

# ---- App ----
GEOAI_SEED=20260101

# Citizen-report feed (simulation). Off by default; set to 1 to enable.
GEOAI_CITIZEN_REPORTS=0

# In-app investigator page (field.html), next to ArcGIS Field Maps. On by default; set to 0 to switch it off.
GEOAI_FIELD_FORM=1

# Language of the task text on investigators' phones in ArcGIS Field Maps: en (default), ar, or both.
GEOAI_FIELD_LANG=en

# Each investigator's ArcGIS Online (Field Maps) username: worker id = username, comma separated.
# GEOAI_FIELD_USERS=WRK-001=nawaf.harbi,WRK-002=khalid.otaibi

# ---- Planner (optional). Without a key the crew uses the offline rule planner. ----
# Planner at start-up: rules | claude | openai | google | lmstudio | ollama | hermes | custom.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# GEOAI_PLANNER=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
